# ─────────────────────────────────────────────────────────────────────────────
# FOODSHI frontend — environment example
# Copy to .env.local (never commit .env.local)
# All NEXT_PUBLIC_* variables are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses (Polygon Amoy)
NEXT_PUBLIC_SHARE_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_MEDAL_NFT_ADDRESS=
NEXT_PUBLIC_EMISSION_POOL_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
