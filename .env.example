# ─────────────────────────────────────────────────────────────────────────────
# FOODSHI — root environment example
# Copy to .env and fill in every blank value before running anything.
# Loaded by: backend (dotenv), contracts/hardhat.config.ts (dotenv path ../..env)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/foodshi

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

# ── Backend server ────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Internal API (Chainlink CRE → backend) ────────────────────────────────────
# openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_long_random_secret

# ── Blockchain — Polygon Amoy testnet ────────────────────────────────────────
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Or use Alchemy: https://polygon-amoy.g.alchemy.com/v2/<ALCHEMY_API_KEY>
ALCHEMY_API_KEY=

# Backend wallet (holds MINTER_ROLE on MedalNFT; needs test MATIC for gas)
PRIVATE_KEY=0x_your_private_key_here

# Verification (optional — only needed for npx hardhat verify)
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Mainnet — leave blank unless intentionally deploying to production
POLYGON_RPC_URL=

# ── Deployed contract addresses ───────────────────────────────────────────────
# Populated after: cd contracts && npx hardhat run scripts/deploy.ts --network amoy
SHARE_TOKEN_ADDRESS=
STAKING_ADDRESS=
TREASURY_ADDRESS=
MEDAL_NFT_ADDRESS=
EMISSION_POOL_ADDRESS=
EMISSION_POOL_RECEIVER_ADDRESS=

# ── Chainlink CRE ─────────────────────────────────────────────────────────────
# Address of the immutable forwarder set in EmissionPoolReceiver constructor
CRE_FORWARDER_ADDRESS=

# ── IPFS / Pinata (medal NFT metadata) ───────────────────────────────────────
PINATA_JWT=

# ── Tenderly Virtual TestNets (optional — for demo deployments) ──────────────
TENDERLY_VIRTUAL_TESTNET_RPC=
TENDERLY_PROJECT=foodshi
TENDERLY_USERNAME=

# ── World ID (sybil prevention) ─────────────────────────────────────────────
# Get an app_id from https://developer.worldcoin.org
# Use app_staging_... to skip cloud verification in dev/demo
WORLDID_APP_ID=app_staging_...
WORLDID_ACTION=verify-donor

# ── Cloudinary (image uploads for donations and posts) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Firebase (optional — only needed for Google/social login) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
