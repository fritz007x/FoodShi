# ─────────────────────────────────────────────────────────────────────────────
# FOODSHI backend — environment example
# The backend loads its variables from the root .env (or a .env in this dir).
# All variables listed here are also present in the root .env.example.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/foodshi

JWT_SECRET=change_me_to_a_long_random_secret
INTERNAL_API_KEY=change_me_to_a_long_random_secret

PORT=3001
FRONTEND_URL=http://localhost:3000

AMOY_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=0x_your_private_key_here

SHARE_TOKEN_ADDRESS=
STAKING_ADDRESS=
TREASURY_ADDRESS=
MEDAL_NFT_ADDRESS=
EMISSION_POOL_ADDRESS=

PINATA_JWT=

# World ID (use app_staging_... to skip cloud verification in dev)
WORLDID_APP_ID=app_staging_...
WORLDID_ACTION=verify-donor

# Optional — Firebase social login
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
